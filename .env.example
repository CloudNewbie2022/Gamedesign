# Reading Habit Tracker - Environment Configuration

# JWT Secret (Change in production!)
JWT_SECRET=your-secret-key-change-in-production-make-it-long-and-random

# Encryption Key for User Data (Change in production!)
ENCRYPTION_KEY=your-encryption-key-change-in-production-32-chars-min

# Server Configuration
PORT=4000
NODE_ENV=development

# Database (Currently using file-based storage)
# No additional config needed for file-based storage

# Optional: StoryGraph Integration
# STORYGRAPH_API_KEY=your-storygraph-api-key

# Optional: Email Configuration (for password resets)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password